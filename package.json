{
  "name": "branch-component",
  "version": "0.2.0",
  "type": "module",
  "description": "a tiny React helper component for better conditional-rendering semantics",
  "keywords": [
    "react",
    "conditional",
    "rendering",
    "component",
    "branch"
  ],
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/branch-component.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "build_lib --terser-strength max",
    "lint": "eslint .",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.1.12",
    "eslint": "10.10.0",
    "eslint-config-jaid": "26.0.0",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "sideEffects": false
}